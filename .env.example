# Copy to `.env` and fill secrets. Never commit `.env`.
# Generate Fernet: uv run python -c "from social_agent.crypto import generate_key; print(generate_key().decode())"

# --- Required for API runtime ---
JWT_SECRET=replace-with-at-least-32-characters-of-secret
FERNET_KEY=
DATABASE_URL=postgresql+psycopg://social:social@127.0.0.1:5432/social_agent
REDIS_URL=redis://127.0.0.1:6379/0

# --- LLM (ADK / Claude). Prefer Anthropic for product demos; Gemini string models also work. ---
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
SOCIAL_AGENT_ROOT_MODEL=claude-sonnet-4-20250514
# SOCIAL_AGENT_COPY_LINKEDIN_MODEL=
# SOCIAL_AGENT_COPY_X_MODEL=
# SOCIAL_AGENT_COPY_BLOG_MODEL=
# SOCIAL_AGENT_COPY_MEDIUM_MODEL=
# SOCIAL_AGENT_COPY_YOUTUBE_MODEL=

# --- Optional API bind (host-side uvicorn) ---
# SOCIAL_AGENT_HOST=0.0.0.0
# SOCIAL_AGENT_PORT=8000
